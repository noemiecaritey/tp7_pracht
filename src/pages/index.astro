---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
---

<Layout title="Accueil – TP7">
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <h1 class="card-title text-2xl">Test Astro et Plot (Observablehq)</h1>
      <div class="overflow-x-auto">
        <PlotFigure
              options={{
                title: "Forme du bec des manchots",
                subtitle: "Profondeur du bec selon sa longueur, par espèce",
                caption:
                  "Figure 1. Nuage de points de la longueur (mm) et de la profondeur (mm) du bec de manchots, coloré par espèce.",
                ariaLabel:
                  "Nuage de points : longueur du bec en abscisse, profondeur du bec en ordonnée, une couleur par espèce",
                x: { label: "Longueur du bec (mm)" },
                y: { label: "Profondeur du bec (mm)" },
                color: { legend: true, label: "Espèce" },
                marks: [
                  Plot.dot(penguins, {
                    x: "culmen_length_mm",
                    y: "culmen_depth_mm",
                    stroke: "species",
                  }),
                ],
              }}
            />
      </div>
    </div>
  </div>
</Layout>
