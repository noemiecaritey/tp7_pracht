---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
---

<Layout>
  <main class="p-4">
    <h1 class="text-2xl">Test Astro et Plot (Observablehq)</h1>
    <nav class="my-2 flex gap-4 underline" aria-label="Pages du TP">
      <a href="/leaflet">Carte Leaflet</a>
      <a href="/geojson">Carte GeoJSON / Plot</a>
    </nav>

    <!-- 0) Accessibilité : title/subtitle/caption génèrent <figure> + <figcaption>,
         ariaLabel est posé sur le <svg> lui-même. -->
    <PlotFigure
      options={{
        title: "Forme du bec des manchots",
        subtitle: "Profondeur du bec selon sa longueur, par espèce",
        caption:
          "Figure 1. Nuage de points de la longueur (mm) et de la profondeur (mm) du bec de manchots, coloré par espèce.",
        ariaLabel:
          "Nuage de points : longueur du bec en abscisse, profondeur du bec en ordonnée, une couleur par espèce",
        x: { label: "Longueur du bec (mm)" },
        y: { label: "Profondeur du bec (mm)" },
        color: { legend: true, label: "Espèce" },
        marks: [
          Plot.dot(penguins, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
          }),
        ],
      }}
    />
  </main>
</Layout>
