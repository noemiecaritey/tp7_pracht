---
// Styles CSS de Leaflet pour l'affichage de la carte
import "leaflet/dist/leaflet.css";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Établissements – Leaflet">
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <h1 class="card-title text-2xl">Établissements (Leaflet)</h1>
      <p class="text-base-content/70">
        Établissements d'enseignement supérieur et de recherche. Cliquez sur un
        marqueur pour voir son nom.
      </p>
      <div id="chargement" class="flex items-center gap-2" role="status">
        <span class="loading loading-spinner loading-sm"></span>
        Chargement de la carte…
      </div>
      <div
        id="map"
        role="region"
        aria-label="Carte des établissements"
        class="z-0 h-[600px] rounded-box"
      >
      </div>
    </div>
  </div>
</Layout>

<script>
  import L from "leaflet";
  // Fichier à placer dans src/assets/ (téléchargé depuis Moodle)
  import listeEtablissements from "../assets/listeEtablissements.json";

  // Carte centrée sur la France, zoom 6
  const map = L.map("map").setView([46.6033, 1.883], 6);

  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution:
      '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  }).addTo(map);

  // Champs du JSON : name, lat, lon
  for (const e of listeEtablissements as { name: string; lat: number; lon: number }[]) {
    if (!Number.isFinite(e.lat) || !Number.isFinite(e.lon)) continue;
    L.marker([e.lat, e.lon], { title: e.name, alt: e.name })
      .addTo(map)
      .bindPopup(e.name);
  }
  document.getElementById("chargement")?.remove();
</script>
