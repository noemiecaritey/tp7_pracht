---
// Styles CSS de Leaflet pour l'affichage de la carte
import "leaflet/dist/leaflet.css";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="p-4">
    <h1 class="text-2xl">Établissements (Leaflet)</h1>
    <p><a class="underline" href="/">Accueil</a></p>
    <div
      id="map"
      role="region"
      aria-label="Carte des établissements"
      style="height: 600px;"
      class="my-4"
    >
    </div>
  </main>
</Layout>

<script>
  import L from "leaflet";
  // Fichier à placer dans src/assets/ (téléchargé depuis Moodle)
  import listeEtablissements from "../assets/listeEtablissements.json";

  // Carte centrée sur la France, zoom 6
  const map = L.map("map").setView([46.6033, 1.883], 6);

  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution:
      '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  }).addTo(map);

  // Champs du JSON : name, lat, lon
  const bounds: L.LatLngTuple[] = [];
  for (const e of listeEtablissements as { name: string; lat: number; lon: number }[]) {
    if (!Number.isFinite(e.lat) || !Number.isFinite(e.lon)) continue;
    L.marker([e.lat, e.lon], { title: e.name, alt: e.name })
      .addTo(map)
      .bindPopup(e.name);
    bounds.push([e.lat, e.lon]);
  }
  if (bounds.length) map.fitBounds(bounds, { padding: [20, 20] });
</script>
