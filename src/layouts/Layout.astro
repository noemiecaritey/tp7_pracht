---
import "../styles/global.css";

const { title = "TP7 – Astro, Plot et Leaflet" } = Astro.props;

const liens = [
  { href: "/", label: "Accueil" },
  { href: "/leaflet", label: "Leaflet" },
  { href: "/geojson", label: "GeoJSON / Plot" },
];
const chemin = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="fr" data-theme="corporate">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-base-200">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded focus:bg-base-100 focus:p-2"
    >
      Aller au contenu
    </a>

    <header class="navbar bg-base-100 shadow-sm">
      <div class="navbar-start">
        <span class="px-2 text-lg font-bold">TP7 · Astro + Plot</span>
      </div>
      <nav class="navbar-end" aria-label="Navigation principale">
        <ul class="menu menu-horizontal gap-1">
          {
            liens.map((l) => (
              <li>
                <a
                  href={l.href}
                  class={chemin === l.href ? "menu-active" : ""}
                  aria-current={chemin === l.href ? "page" : undefined}
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="contenu" class="mx-auto max-w-6xl p-4">
      <slot />
    </main>
  </body>
</html>
